# Local development only. Copy to .env (ignored by Git): cp .env.example .env
# Values match the PostgreSQL service of the root docker-compose.yml.

DATABASE_URL=postgresql://epiverse:epiverse_dev@localhost:5432/epiverse?schema=public

# Rate limiting. These are the defaults; change them only to test other limits.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=30

# Failed logins allowed per account and client address, and the window in minutes
LOGIN_FAILURE_MAX=5
LOGIN_FAILURE_WINDOW_MINUTES=15

# Number of reverse proxies in front of the API. No proxy in local development.
TRUST_PROXY_HOPS=0

# Session lifetime after login, in hours (168 = 7 days)
SESSION_TTL_HOURS=168

# Version of the terms of use accepted at registration
CGU_VERSION=1.0
