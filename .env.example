# EpiVerse — variables de l'environnement local (Docker Compose)
# À copier :  cp .env.example .env    (le .env reste sur ta machine, il n'est jamais commité)

# Dossiers des applications dans le dépôt (à ajuster si le squelette utilise d'autres noms)
API_DIR=apps/api
APP_DIR=apps/app

# PostgreSQL local (valeurs de développement, sans risque)
POSTGRES_USER=epiverse
POSTGRES_PASSWORD=epiverse_dev
POSTGRES_DB=epiverse
POSTGRES_PORT=5432

# Redis local
REDIS_PORT=6379

# Ports sur ta machine
ADMINER_PORT=8082
WEB_PORT=8080

# Quand l'API tourne hors Docker (npm run start:dev), mettre dans apps/api/.env :
#   DATABASE_URL=postgresql://epiverse:epiverse_dev@localhost:5432/epiverse?schema=public
#   REDIS_URL=redis://localhost:6379
