# EpiVerse — configuration d'un environnement serveur.
# Copier en /opt/epiverse/staging/.env (ou /opt/epiverse/production/.env), puis remplir.
# Ce fichier rempli ne quitte jamais le serveur.
#
# Valeurs sans guillemets. Mots de passe : lettres et chiffres uniquement (ils sont insérés dans des URL).
# Pour en générer un :  openssl rand -hex 24

COMPOSE_PROJECT_NAME=epiverse-staging
ENV_NAME=staging

# Images publiées par la CI sur GitHub Container Registry (propriétaire du dépôt, en minuscules)
IMAGE_REGISTRY=ghcr.io/nom-de-l-organisation
# Laisser vide : deploy.sh le remplit à chaque déploiement (sert au retour arrière)
IMAGE_TAG=

POSTGRES_USER=epiverse
POSTGRES_PASSWORD=
POSTGRES_DB=epiverse
# Mot de passe distinct pour le rôle SQL applicatif sans DDL, à générer par openssl rand -hex 24
APP_DB_PASSWORD=
REDIS_PASSWORD=

# Sauvegardes (infra/scripts/backup-db.sh)
BACKUP_DIR=/opt/epiverse/backups/staging
BACKUP_RETENTION_DAYS=14
# Phrase de chiffrement : à garder aussi hors du serveur (gestionnaire de mots de passe), sinon
# les sauvegardes sont illisibles si le serveur est perdu.
BACKUP_PASSPHRASE=
# Copie hors du serveur (obligatoire en production) : remote rclone distant, ex. scaleway:epiverse-backups.
# Les chemins locaux et le backend "local:" sont refusés par le script.
BACKUP_RCLONE_REMOTE=
