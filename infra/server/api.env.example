# EpiVerse — secrets applicatifs de l'API sur le serveur.
# Copier en /opt/epiverse/<env>/api.env puis remplir. Seul le conteneur de l'API reçoit ce fichier.
# DATABASE_URL, REDIS_URL, PORT et APP_ENV sont déjà fournis par docker-compose.server.yml.
# Générer un secret :  openssl rand -hex 32

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGINS=https://staging.exemple.fr

# Ajouter ici les variables des modules du back au fur et à mesure (e-mail, stockage, etc.)
